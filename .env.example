# Markenfrei: alle Variablen sind optional. Ohne Eintrag gelten die Standardwerte.
# Kopieren nach .env.local und anpassen. Diese Datei enthält keine Geheimnisse.

# Höheres Rate-Limit für die GitHub-Abfragen (Handle und Repo-Suche).
# Ohne Token: 60 Anfragen/Stunde und 10 Suchanfragen/Minute je Server-IP.
# Ein Token ohne besondere Rechte (nur lesen, öffentliche Daten) reicht.
# GITHUB_TOKEN=

# Anfragen pro Minute und IP für alle öffentlichen Routen (Standard 60)
# MARKENFREI_RATE_LIMIT=60

# Lebensdauer des Caches für eindeutige Quellenantworten in Sekunden (Standard 600, 0 = aus)
# MARKENFREI_CACHE_TTL_SEC=600

# Nur für lokalen Betrieb: erlaubt appPath in /api/rea-inspect (liest lokale .app-Pakete)
# MARKENFREI_ENABLE_LOCAL_INSPECT=1

# Markenfrei: alle Variablen sind optional. Ohne Eintrag gelten die Standardwerte.
# Für npm run dev und npm run start: nach .env.local kopieren und anpassen.
# Docker übernimmt .env.local nicht: Variablen in docker-compose.yml unter environment:
# eintragen oder dort mit env_file: einbinden. Diese Datei enthält keine Geheimnisse.
# Nur Docker Compose: Port auf dem Rechner (nur 127.0.0.1), Standard 3000. Nötig, wenn 3000 belegt ist.
# MARKENFREI_HOST_PORT=3000

# PFLICHT FÜR DEN LIVEGANG: Betreiberangaben für Impressum und Datenschutzerklärung.
# Ohne sie zeigen /impressum und /datenschutz einen sichtbaren Hinweis. Adresse mehrzeilig mit \n.
# MARKENFREI_OPERATOR_NAME=Vorname Nachname
# MARKENFREI_OPERATOR_ADDRESS=Musterstraße 1\n12345 Musterstadt
# MARKENFREI_OPERATOR_EMAIL=kontakt@example.org
# MARKENFREI_OPERATOR_PHONE=
# MARKENFREI_HOSTING_PROVIDER=Name und Sitz des Hosting-Anbieters

# Kontakt im User-Agent: Markenfrei/2.0 (+https://markenfrei.app; <Kontakt>)
# Packagist wird nur mit einer E-Mail-Adresse (mit oder ohne mailto:) abgefragt, sonst meldet
# die Quelle "unknown".
# MARKENFREI_CONTACT=mailto:ops@example.org

# Zusätzliche Origins (kommagetrennt), die /api/mcp aufrufen dürfen.
# Ohne Origin-Header ist der Aufruf immer erlaubt; mit Header sonst nur der eigene Host,
# localhost und 127.0.0.1.
# MARKENFREI_ALLOWED_ORIGINS=https://example.org,https://app.example.org

# Token für die GitHub-Abfrage (Nutzer und Organisationen).
# Ohne Token: 60 Anfragen pro Stunde je Server-IP. Ein Token ohne Berechtigungen reicht.
# GITHUB_TOKEN=

# Anzahl vertrauenswürdiger Proxys vor der App (Standard 1: Caddy, nginx oder Vercel).
# x-forwarded-for wird von rechts gelesen; 0 ignoriert den Header (alle Anfragen zählen gemeinsam).
# MARKENFREI_TRUSTED_PROXIES=1

# Öffentliche Adresse dieser Instanz, gilt als erlaubter Origin für /api/mcp und /api/check
# (Standard https://markenfrei.app).
# MARKENFREI_PUBLIC_URL=https://markenfrei.app

# Obergrenze pro Serverprozess für Anfragen, die Abfragen bei Dritten auslösen, in Einheiten
# pro Minute (Standard 600; ein Name zählt eine Einheit). Greift zusätzlich zum Limit pro IP.
# MARKENFREI_GLOBAL_RATE_LIMIT=600

# Optionales Lese-Token für die Quelle "Hugging Face" (nur wenn sie genutzt wird).
# Anonym 500, mit Free-Konto 1.000 API-Abfragen je 5 Minuten. Geht nur an huggingface.co.
# HF_TOKEN=

# Anfragen pro Minute und IP für alle öffentlichen Routen (Standard 60).
# Bei /api/check und markenfrei_check_names zählt jeder Name einzeln.
# MARKENFREI_RATE_LIMIT=60

# Lebensdauer des Caches für eindeutige Quellenantworten in Sekunden (Standard 600, 0 = aus)
# MARKENFREI_CACHE_TTL_SEC=600
